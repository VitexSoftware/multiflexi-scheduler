[Unit]
Description=MultiFlexi Scheduler
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
User=multiflexi
Group=multiflexi
EnvironmentFile=/etc/multiflexi/multiflexi.env
ExecStart=/usr/bin/php /usr/lib/multiflexi-scheduler/daemon.php
LimitNOFILE=8192:16384
Type=simple
# Restart also after a clean exit: SIGTERM and the memory safeguard make the
# daemon finish its current tick and leave, and the successor must be started.
Restart=always
TimeoutStopSec=120s
RestartSec=15s

[Install]
WantedBy=multi-user.target
